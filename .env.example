# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Target Telegram channel id (numeric, e.g. -1001234567890) or @channel_username
TELEGRAM_CHANNEL_ID=

# Optional: cron expression for the publish schedule (UTC). Defaults to every minute.
# PUBLISH_CRON=* * * * *

# Optional: HTTP request timeout in seconds per source. Defaults to 10.
# HTTP_TIMEOUT_SECONDS=10

# Optional: T-Bank category to pick from /v1/currency_rates.
# Defaults to ATMCashoutRateGroup — the rate shown on the ATM screen
# when exchanging cash USD (matches the "обмен валюты в банкомате" rate).
# Alternatives: ATMRateGroup, DebitCardsOperations, CUTransferAbove100, etc.
# TBANK_RATE_CATEGORY=ATMCashoutRateGroup

# Optional: AkBars city FIAS reference (defaults to Kazan).
# AKBARS_CITY_FIAS_REF=6b1bab7d-ee45-4168-a2a6-4ce2880d90d3

# Optional: HTTP proxy applied to ALL rate-source requests (AkBars, T-Bank,
# CBR, etc.). Telegram traffic is NOT routed through it. Useful when running
# from outside RU since several sources geo-block non-RU IPs.
# Format: http://user:pass@host:port  (SOCKS5 is not supported here.)
# HTTP_PROXY_URL=

# Optional: log level (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# LOG_LEVEL=INFO

# Optional: log format (json | console). Defaults to json.
# LOG_FORMAT=json
